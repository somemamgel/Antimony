@page "{id:int?}"
@model Antimony.Core.Pages.Admin.Posts.EditModel
@{ ViewData["Title"] = Model.Id is null ? "新建文章" : "编辑文章"; }
<div class="heading-actions"><h1>@ViewData["Title"]</h1><span class="badge @(Model.IsPublished ? "bg-success" : "bg-secondary")">@(Model.IsPublished ? "已发布" : "草稿")</span></div>
<form method="post" id="post-editor" data-preview-url="@Url.Page("Edit", "Preview", new { id = Model.Id })">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Input.Title" class="form-label">标题</label><input asp-for="Input.Title" class="form-control" maxlength="200" required /></div>
    <div class="mb-3">
        <label asp-for="Input.Tags" class="form-label">标签</label><input asp-for="Input.Tags" class="form-control" placeholder="例如：生活, 编程, .NET" />
        <div class="form-text">用中英文逗号分隔，保存时自动创建新标签。</div>
        @if (Model.AvailableTags.Count > 0)
        {
            <div class="tag-list mt-2">
            @foreach (var tag in Model.AvailableTags) { <button type="button" class="tag tag-button" data-add-tag="@tag">@tag</button> }
            </div>
        }
    </div>
    <div class="editor-toolbar"><label asp-for="Input.Markdown" class="form-label">Markdown 正文</label><button type="button" id="preview-button" class="btn btn-sm btn-outline-secondary">更新预览</button></div>
    <div class="editor-grid">
        <textarea asp-for="Input.Markdown" class="form-control markdown-input" rows="22" required placeholder="用 Markdown 开始写作……"></textarea>
        <section class="preview-panel" aria-label="文章预览"><div id="markdown-preview" class="markdown-body"><p class="text-muted">点击“更新预览”查看排版。</p></div></section>
    </div>
    <p id="preview-status" class="text-danger mt-2" role="status"></p>
    <div class="action-list mt-4">
        <button class="btn btn-primary" name="action" value="save">@(Model.IsPublished ? "保存并更新公开文章" : "保存草稿")</button>
        @if (!Model.IsPublished) { <button class="btn btn-success" name="action" value="publish">发布文章</button> }
        else { <button class="btn btn-outline-secondary" name="action" value="withdraw">保存并撤回</button> }
        <a class="btn btn-outline-secondary" asp-page="Index">返回</a>
    </div>
</form>
