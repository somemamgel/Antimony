<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Antimony</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Antimony.Core.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Antimony</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="展开导航"><span class="navbar-toggler-icon"></span></button>
                <div id="main-navigation" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">文章</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Tags/Index">标签</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Posts/Index">文章管理</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Tags/Index">标签管理</a></li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Admin/Logout"><button class="btn btn-sm btn-outline-secondary" type="submit">退出登录</button></form>
                    }
                    else { <a class="nav-link" asp-page="/Admin/Login">管理登录</a> }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container pb-5">@RenderBody()</main>
    <footer class="border-top text-muted"><div class="container py-3">&copy; @DateTime.UtcNow.Year Antimony</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
